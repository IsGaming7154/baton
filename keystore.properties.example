# Copy this file to `keystore.properties` (which is gitignored) and fill it in.
# Without it the project still builds; `assembleRelease` just leaves the APK
# unsigned. Never commit the real file, and never paste its contents anywhere.

storeFile=C:/Users/Acer/baton-release.jks
storePassword=<the password you chose when you created the key>
keyAlias=baton
# PKCS12 keystores use one password for both; leave this out and the store
# password is used.
#keyPassword=
